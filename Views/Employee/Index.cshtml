@model IEnumerable<EmployeeTagHelperDemo.Models.Employee>

@{
    ViewData["Title"] = "Employees List";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Employees Directory</h3>
        <p class="text-muted small mb-0">Manage personnel records using ASP.NET Core Tag Helpers</p>
    </div>
    <a asp-controller="Employee" asp-action="Create" class="btn btn-primary rounded-3 px-4 py-2 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add New Employee
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Name</th>
                    <th>Salary</th>
                    <th>Address</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">#@emp.Id</td>
                        <td class="fw-semibold">@emp.Name</td>
                        <td class="text-success fw-bold">$@emp.Salary.ToString("N0")</td>
                        <td>@emp.Address</td>
                        <td class="text-end pe-4">
                            <!-- ActionLink via Tag Helpers -->
                            <a asp-controller="Employee" asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-primary px-3 rounded-pill">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
