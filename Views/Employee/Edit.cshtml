    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model EmployeeTagHelperDemo.Models.EmployeeViewModel

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-0">
                <h4 class="fw-bold text-primary mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Employee Info</h4>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Employee" asp-action="Edit" method="post">
                    <!-- Hidden ID Tag Helper -->
                    <input type="hidden" asp-for="Id" />

                    <!-- Name Field Tag Helper -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control form-control-lg rounded-3" placeholder="Enter full name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Salary Field Tag Helper -->
                    <div class="mb-3">
                        <label asp-for="Salary" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Salary" class="form-control form-control-lg rounded-3" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Salary" class="text-danger small"></span>
                    </div>

                    <!-- Address Field Tag Helper -->
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <input asp-for="Address" class="form-control form-control-lg rounded-3" placeholder="Enter address" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <!-- Department Select Tag Helper -->
                    <div class="mb-4">
                        <label asp-for="DepartmentId" class="form-label fw-semibold">Department</label>
                        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select form-select-lg rounded-3">
                            <option value="">-- Choose Department --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>

                    <!-- Action Buttons Tag Helpers -->
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-3">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-primary px-5 py-2 rounded-3 fw-semibold">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>