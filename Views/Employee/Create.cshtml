@model EmployeeTagHelperDemo.Models.EmployeeViewModel

@{
    ViewData["Title"] = "Create Employee";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-0">
                <h4 class="fw-bold text-success mb-0"><i class="bi bi-person-plus me-2"></i>Add New Employee</h4>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Employee" asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control form-control-lg rounded-3" placeholder="Enter full name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Salary" class="form-label fw-semibold"></label>
                        <input asp-for="Salary" class="form-control form-control-lg rounded-3" type="number" />
                        <span asp-validation-for="Salary" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <input asp-for="Address" class="form-control form-control-lg rounded-3" placeholder="Enter address" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DepartmentId" class="form-label fw-semibold">Department</label>
                        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select form-select-lg rounded-3">
                            <option value="">-- Choose Department --</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-3">Back to List</a>
                        <button type="submit" class="btn btn-success px-5 py-2 rounded-3 fw-semibold">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>